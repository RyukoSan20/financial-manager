# The environment for a local run of the backend.
#
# Copy this to backend/.env and fill it in. backend/.env is ignored by
# git, so a password written in it stays on this machine.
#
# The scripts backend/run.sh and backend/start.sh read this file.

# The database.
DATABASE_URL=postgresql://finmanager:your_password_here@localhost:5432/finmanager

# The key the tokens are signed with. A long random string. The
# development default below is not a secret and must not be used
# anywhere real.
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Where the frontend runs, so the browser is allowed to call the API.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Google sign-in. Leave these empty to turn the Gmail and Google
# features off; the pages then say the server is not set up, which is
# the honest answer.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# The AI features. The key comes from the Google AI Studio.
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Off in development, so the server says what it is doing.
DEBUG=true
