    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "lint:guard": "eslint src --ext .js,.jsx --max-warnings 100000 --rule 'no-undef:error' --rule 'no-dupe-keys:error' --rule 'no-const-assign:error' --rule 'no-dupe-args:error' --rule 'no-unreachable:error' --rule 'no-constant-condition:error' --rule 'no-func-assign:error' --rule 'no-import-assign:error' --rule 'no-self-assign:error' --rule 'no-unsafe-finally:error' --rule 'use-isnan:error' --rule 'valid-typeof:error' --rule 'no-sparse-arrays:error' --rule 'no-cond-assign:error' --rule 'no-debugger:error' --rule 'no-dupe-class-members:error'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "axios": "^1.6.7",
    "clsx": "^2.1.0",
