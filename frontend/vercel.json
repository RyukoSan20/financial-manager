{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fin-manager-production.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://fin-manager-production.up.railway.app/health"
    }
  ],
  "fallback": {
    "cache-Control": "public, max-age=0, must-revalidate"
  }
}
