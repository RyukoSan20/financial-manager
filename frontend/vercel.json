{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://famous-poets-smash.loca.lt/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://famous-poets-smash.loca.lt/health"
    }
  ]
}
